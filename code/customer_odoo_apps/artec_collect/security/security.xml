<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="artec_collect_basic_category">
        <field name="name">Basic Category</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="artec_collect_basic_category"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="artec_collect_basic_category"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="artec_collect_basic_category"/>
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
    </record>

</odoo>
