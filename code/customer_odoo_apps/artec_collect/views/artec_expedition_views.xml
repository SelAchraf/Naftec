<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="artec_expedition_view_tree" model="ir.ui.view">
        <field name="name">Artec Expedition Tree View</field>
        <field name="model">artec.expedition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="tank_id"></field>
                <field name="start_datetime"></field>
                <field name="end_datetime"></field>
                <field name="expedited_volume" width="200"></field>
            </list>
        </field>
    </record>

    <record id="artec_expedition_view_form" model="ir.ui.view">
        <field name="name">Artec Expedition Form View</field>
        <field name="model">artec.expedition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tank_id"/>
                        </group>
                        <group>
                            <field name="expedited_volume"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Physical Parameters">
                            <group>
                                <group>
                                    <field name="start_temperature"></field>
                                    <field name="start_density"></field>
                                </group>
                                <group>
                                    <field name="end_temperature"></field>
                                    <field name="end_density"></field>                                
                                </group>
                            </group>
                        </page>

                        <page string="Expedition Informations">
                            <group>
                                <group>
                                    <field name="start_datetime"></field>
                                    <field name="start_depth"></field>
                                    <field name="start_volume"></field>
                                </group>
                                <group>
                                    <field name="end_datetime"></field>
                                    <field name="end_depth"></field>
                                    <field name="end_volume"></field>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="artec_expedition_view_search" model="ir.ui.view">
		<field name="name">Artec Expedition Search View</field>
		<field name="model">artec.expedition</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="tank_id"></field>
				<field name="start_datetime"></field>
				<field name="end_datetime"></field>
                <filter name="yesterday" string="Yesterday" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(days = -1)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_week" string="Last Week" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(weeks = -1)).strftime('%Y-%m-%d')), ('start_datetime','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Last Month" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(months = -1)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_three_months" string="Last 3 Months" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(months = -3)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_six_months" string="Last 6 Months" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(months = -6)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_year" string="Last Year" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(years = -1)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="group_by_tank" string="Tank" context="{'group_by': 'tank_id'}" />
			</search>
		</field>
	</record>

    <record id="artec_expedition_view_pivot" model="ir.ui.view">
        <field name="name">Artec Expedition Pivot View</field>
        <field name="model">artec.expedition</field>
        <field name="arch" type="xml">
            <pivot string="From expedition pivot view">
                <field name="tank_id" type="col"/>
                <field name="end_datetime" type="row" interval="day"/>
                <field name="expedited_volume" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="artec_expedition_view_graph" model="ir.ui.view">
        <field name="name">Artec Expedition Graph View</field>
        <field name="model">artec.expedition</field>
        <field name="arch" type="xml">
            <graph string="From expedition graph view" type="bar" stacked="0">
                <field name="end_datetime" interval="day"/>
                <field name="tank_id" />
                <field name="expedited_volume" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="artec_expedition_action" model="ir.actions.act_window">
		<field name="name">Expedition</field>
		<field name="res_model">artec.expedition</field>
		<field name="view_mode">list,form</field>
	</record>

    <record id="artec_expedition_reporting_action" model="ir.actions.act_window">
        <field name="name">Expedition Reporting</field>
        <field name="res_model">artec.expedition</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('end_datetime', '!=', False)]</field>
    </record>

</odoo>
