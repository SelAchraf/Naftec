<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="artec_product_view_tree" model="ir.ui.view">
		<field name="name">Artec Product Tree View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="color" widget="color_picker"/>
				<field name="tank_ids" widget="many2many_tags"/>
			</list>
		</field>
	</record>

	<record id="artec_product_view_form" model="ir.ui.view">
		<field name="name">Artec Product Form View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
					<group>
						<field name="color" widget="color_picker"/>
						<field name="tank_ids" widget="many2many_tags"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="artec_product_view_search" model="ir.ui.view">
		<field name="name">Artec Product Search View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="tank_ids"></field>
			</search>
		</field>
	</record>

	<record id="artec_product_view_kanban" model="ir.ui.view">
		<field name="name">Artec Product Kanban View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_small_column">
				<field name="name"/>
				<field name="color"/>
				<field name="tank_ids"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_card oe_kanban_global_click card border-0 shadow-sm h-100" style="background-color: #ffffff; transition: transform 0.2s, box-shadow 0.2s;" t-att-class="'oe_kanban_color_' + record.color.raw_value">
							<div class="oe_kanban_content p-3 d-flex flex-column">
								<!-- Header with product name -->
								<div class="d-flex align-items-center mb-3">
									<h4 class="mb-0 text-truncate fw-bold fs-2">
										<field name="name"/>
									</h4>
								</div>
								<!-- Tank tags -->
								<div class="mt-auto d-flex flex-row align-items-start gap-2">
									<strong class="text-muted small">Tanks: </strong>
									<t t-if="record.tank_ids.raw_value.length > 0">
                                        <field name="tank_ids" widget="many2many_tags" class="mt-1"/>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted small">No tanks assigned</span>
                                    </t>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="artec_product_action" model="ir.actions.act_window">
		<field name="name">Product</field>
		<field name="res_model">artec.product</field>
		<field name="view_mode">list,kanban,form</field>
	</record>
</odoo>
