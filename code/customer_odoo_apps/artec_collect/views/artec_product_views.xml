<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="artec_product_view_tree" model="ir.ui.view">
		<field name="name">Artec Product Tree View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="color" widget="color_picker"/>
				<field name="tank_ids" widget="many2many_tags"/>
			</list>
		</field>
	</record>

	<record id="artec_product_view_form" model="ir.ui.view">
		<field name="name">Artec Product Form View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
					<group>
						<field name="color" widget="color_picker"/>
						<field name="tank_ids" widget="many2many_tags"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="artec_product_view_search" model="ir.ui.view">
		<field name="name">Artec Product Search View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="tank_ids"></field>
			</search>
		</field>
	</record>

	<record id="artec_product_view_kanban" model="ir.ui.view">
		<field name="name">Artec Product Kanban View</field>
		<field name="model">artec.product</field>
		<field name="arch" type="xml">
			<kanban>
				<field name="name"/>
                <field name="color"/>
                <field name="tank_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_content">
                                <h4><field name="name"/></h4>
                                <div>
                                    <strong>Color: </strong> 
									<field name="color"/>
                                </div>
                                <div>
                                    <strong>Tanks: </strong>
									<field name="tank_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
			</kanban>
		</field>
	</record>

	<record id="artec_product_action" model="ir.actions.act_window">
		<field name="name">Product</field>
		<field name="res_model">artec.product</field>
		<field name="view_mode">list,kanban,form</field>
	</record>
</odoo>
