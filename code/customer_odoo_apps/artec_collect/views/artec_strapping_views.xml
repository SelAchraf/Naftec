<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="artec_strapping_view_tree" model="ir.ui.view">
        <field name="name">Artec Strapping Tree View</field>
        <field name="model">artec.strapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="tank_id"></field>
                <field name="start_datetime"></field>
                <field name="end_datetime"></field>
                <field name="active"></field>
            </list>
        </field>
    </record>

    <record id="artec_strapping_view_form" model="ir.ui.view">
        <field name="name">Artec Strapping Form View</field>
        <field name="model">artec.strapping</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state == 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tank_id" readonly="state == 'confirmed'"></field>
                        </group>
                        <group>
                            <field name="start_datetime" readonly="state == 'confirmed'"></field>
                            <field name="end_datetime"></field>
                            <field name="active"></field>
                        </group>
                    </group>
                    <group>
                        <field name="strapping_line_ids" readonly="state == 'confirmed'">
                            <list editable='bottom'>
                                <field name="depth"></field>
                                <field name="volume"></field>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="artec_strapping_view_search" model="ir.ui.view">
        <field name="name">Artec Strapping Search View</field>
        <field name="model">artec.strapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"></field>
                <field name="tank_id"></field>
                <field name="start_datetime"></field>
                <field name="end_datetime"></field>
                <filter name="is_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="active_yesterday" string="Yesterday" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(days = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_week" string="Last Week" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(weeks = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_month" string="Last Month" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(months = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_three_months" string="Last 3 Months" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(months = -3)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_six_months" string="Last 6 Months" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(months = -6)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_year" string="Last Year" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(years = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="group_by_tank" string="Tank" context="{'group_by': 'tank_id'}" />
            </search>
        </field>
    </record>

    <record id="artec_strapping_action" model="ir.actions.act_window">
        <field name="name">Strapping</field>
        <field name="res_model">artec.strapping</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>