<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="artec_tank_view_tree" model="ir.ui.view">
		<field name="name">Artec Tank Tree View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<list>
				<field name="name" />
				<field name="product_id" />
				<field name="height" width="150"/>
				<field name="width" width="150"/>
				<field name="current_volume" width="200"/>
				<field name="capacity" width="150"/>
				<field name="percentage" width="150"/>
			</list>
		</field>
	</record>

	<record id="artec_tank_view_form" model="ir.ui.view">
		<field name="name">Artec Tank Form View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div name="button_box" class="oe_button_box d-flex gap-3">
						<button name="action_get_strapping_records" invisible="strapping_count == False" 
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Strappings</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="strapping_count" />
								</span>
						</button>
						<button name="action_get_gauging_records" invisible="gauging_count == False"
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Gaugings</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="gauging_count" />
								</span>
						</button>
						<button name="action_get_expedition_records" invisible="expedition_count == False"
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Expeditions</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="expedition_count" />
								</span>
						</button>
						<button name="action_get_production_records" invisible="production_count == False"
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Productions</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="production_count" />
								</span>
						</button>
					</div>
					<div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"/>
                        </h1>
                    </div>
					<notebook>
                        <page string="Informations">
                            <group>
								<field name="product_id"></field>
								<field name="current_volume"></field>
								<field name="percentage"></field>
                            </group>
                        </page>
                        <page string="Dimensions">
                            <group>
								<field name="width"></field>
								<field name="height"></field>
								<field name="capacity"></field>
                            </group>
                        </page>
                    </notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="artec_tank_view_search" model="ir.ui.view">
		<field name="name">Artec Tank Search View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="width"></field>
				<field name="height"></field>
				<field name="current_volume"></field>
				<field name="capacity"></field>
				<field name="product_id"></field>
				<field name="strapping_ids"></field>
				<filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}" />
			</search>
		</field>
	</record>

	<record id="artec_tank_view_kanban" model="ir.ui.view">
		<field name="name">Artec Tank Kanban View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<kanban class="o_kanban_small_column">
				<field name="name"/>
				<field name="width"/>
				<field name="height"/>
				<field name="capacity"/>
				<field name="product_id"/>
				<field name="color"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_card oe_kanban_global_click card border-0 shadow-sm h-100" style="background-color: #ffffff; transition: transform 0.2s, box-shadow 0.2s;" t-att-class="'oe_kanban_color_' + record.color.raw_value">
							<div class="oe_kanban_content p-3 d-flex flex-column">
								<!-- Header with tank name -->
								<div class="d-flex align-items-center mb-3">
									<h4 class="mb-0 text-truncate fw-bold fs-2">
										<field name="name"/>
									</h4>
								</div>
								<!-- Tank details -->
								<div class="p-0 container o_kanban_card_content">
									<ul class="list-group">
										<li class="list-group-item d-flex justify-content-between" t-if="record.product_id.raw_value">
											Product:
											<span class="badge bg-primary badge-pill text-white">
												<field name="product_id"/>
											</span>
										</li>
										<li class="list-group-item d-flex justify-content-between" t-if="!record.product_id.raw_value">
											Product:
											<span class="badge bg-secondary badge-pill text-muted">
												No product assigned
											</span>
										</li>
										<li class="list-group-item d-flex justify-content-between">
											Width:
											<span class="badge bg-primary badge-pill text-white">
												<field name="width"/> m
											</span>
										</li>
										<li class="list-group-item d-flex justify-content-between">
											Height:
											<span class="badge bg-primary badge-pill text-white">
												<field name="height"/> m
											</span>
										</li>
										<li class="list-group-item d-flex justify-content-between">
											Capacity:
											<span class="badge bg-primary badge-pill text-white">
												<field name="capacity"/> m³
											</span>
										</li>										
									</ul>
									<field name="current_volume" widget="gauge" options="{'max_field': 'capacity'}"/>
									<ul class="list-group">
										<li class="list-group-item d-flex justify-content-between">
											Percentage:
											<span class="badge bg-primary badge-pill text-white">
												<field name="percentage"/> %
											</span>
										</li>
									</ul>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="artec_tank_action" model="ir.actions.act_window">
		<field name="name">Tank</field>
		<field name="res_model">artec.tank</field>
		<field name="view_mode">list,kanban,form</field>
	</record>
</odoo>
