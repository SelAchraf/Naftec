<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="artec_tank_view_tree" model="ir.ui.view">
		<field name="name">Artec Tank Tree View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<list>
				<field name="name" />
				<field name="product_id" />
				<field name="length" width="150"/>
				<field name="width" width="150"/>
			</list>
		</field>
	</record>

	<record id="artec_tank_view_form" model="ir.ui.view">
		<field name="name">Artec Tank Form View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div name="button_box" class="oe_button_box d-flex gap-3">
						<button name="action_get_strapping_records" 
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Strappings</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="strapping_count" />
								</span>
						</button>
						<button name="action_get_expedition_records" 
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Expeditions</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="expedition_count" />
								</span>
						</button>
						<button name="action_get_production_records" 
								type="object" 
								class="oe_stat_button btn btn-sm btn-primary rounded-pill d-flex align-items-center justify-content-center gap-2 shadow-sm hover:bg-blue-600">
								<span>Productions</span>
								<span class="badge bg-light text-dark rounded-pill">
									<field name="production_count" />
								</span>
						</button>
					</div>
					<div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"/>
                        </h1>
                    </div>
					<notebook>
                        <page string="Informations">
                            <group>
								<field name="product_id"></field>
                            </group>
                        </page>
                        <page string="Dimensions">
                            <group>
								<field name="width"></field>
								<field name="length"></field>
                            </group>
                        </page>
                    </notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="artec_tank_view_search" model="ir.ui.view">
		<field name="name">Artec Tank Search View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="width"></field>
				<field name="length"></field>
				<field name="product_id"></field>
				<field name="strapping_ids"></field>
				<filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}" />
			</search>
		</field>
	</record>

	<record id="artec_tank_view_kanban" model="ir.ui.view">
		<field name="name">Artec Tank Kanban View</field>
		<field name="model">artec.tank</field>
		<field name="arch" type="xml">
			<kanban>
				<field name="name"/>
                <field name="width"/>
                <field name="length"/>
                <field name="product_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_content">
                                <h4><field name="name"/></h4>
                                <div>
                                    <strong>Width: </strong> 
									<field name="width"/>
                                </div>
                                <div>
                                    <strong>Length: </strong>
									<field name="length"/>
                                </div>                                
								<div>
                                    <strong>Product: </strong>
									<field name="product_id"/>
                                </div>
								<div>
									<strong>Strapping: </strong>
									<field name="strapping_ids" widget="many2many_tags"/>
								</div>
                            </div>
                        </div>
                    </t>
                </templates>
			</kanban>
		</field>
	</record>

	<record id="artec_tank_action" model="ir.actions.act_window">
		<field name="name">Tank</field>
		<field name="res_model">artec.tank</field>
		<field name="view_mode">list,kanban,form</field>
	</record>
</odoo>
