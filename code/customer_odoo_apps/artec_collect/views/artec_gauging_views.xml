<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="artec_gauging_view_tree" model="ir.ui.view">
        <field name="name">Artec Gauging Tree View</field>
        <field name="model">artec.gauging</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="tank_id"></field>
                <field name="datetime"></field>
                <field name="volume"></field>
            </list>
        </field>
    </record>

    <record id="artec_gauging_view_form" model="ir.ui.view">
        <field name="name">Artec Gauging Form View</field>
        <field name="model">artec.gauging</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tank_id"></field>
                            <field name="datetime"></field>
                        </group>
                        <group>
                            <field name="volume"></field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tank Status">
                            <group>
                                <field name="depth"></field>
                                <field name="theoretical_volume"></field>
                            </group>
                        </page>
                        <page string="Physical Parameters">
                            <group>
                                <field name="temperature"></field>
                                <field name="density"></field>
                                <field name="coefficient"></field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="artec_gauging_view_search" model="ir.ui.view">
		<field name="name">Artec Gauging Search View</field>
		<field name="model">artec.gauging</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="tank_id"></field>
				<field name="datetime"></field>
                <filter name="yesterday" string="Yesterday" domain="[('datetime', '&gt;=', (context_today() + relativedelta(days = -1)).strftime('%Y-%m-%d')), ('datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_week" string="Last Week" domain="[('datetime', '&gt;=', (context_today() + relativedelta(weeks = -1)).strftime('%Y-%m-%d')), ('datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_month" string="Last Month" domain="[('datetime', '&gt;=', (context_today() + relativedelta(months = -1)).strftime('%Y-%m-%d')), ('datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_three_months" string="Last 3 Months" domain="[('datetime', '&gt;=', (context_today() + relativedelta(months = -3)).strftime('%Y-%m-%d')), ('datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_six_months" string="Last 6 Months" domain="[('datetime', '&gt;=', (context_today() + relativedelta(months = -6)).strftime('%Y-%m-%d')), ('datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_year" string="Last Year" domain="[('datetime', '&gt;=', (context_today() + relativedelta(years = -1)).strftime('%Y-%m-%d')), ('datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="group_by_tank" string="Tank" context="{'group_by': 'tank_id'}" />
                <filter name="group_by_date" string="Date" context="{'group_by': 'datetime'}" />
			</search>
		</field>
	</record>

    <record id="artec_gauging_view_pivot" model="ir.ui.view">
        <field name="name">Artec Gauging Pivot View</field>
        <field name="model">artec.gauging</field>
        <field name="arch" type="xml">
            <pivot string="From gauging pivot view">
                <field name="tank_id" type="col"/>
                <field name="datetime" type="row" interval="day"/>
                <field name="volume" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="artec_gauging_view_graph" model="ir.ui.view">
        <field name="name">Artec Gauging Graph View</field>
        <field name="model">artec.gauging</field>
        <field name="arch" type="xml">
            <graph string="From gauging graph view" type="bar" stacked="0">
                <field name="datetime" interval="day"/>
                <field name="tank_id" />
                <field name="volume" type="measure"/>
            </graph>
        </field>
    </record>
    
    <record id="artec_gauging_action" model="ir.actions.act_window">
		<field name="name">Gauging</field>
		<field name="res_model">artec.gauging</field>
		<field name="view_mode">list,form</field>
	</record>

    <record id="artec_gauging_reporting_action" model="ir.actions.act_window">
        <field name="name">Gauging Reporting</field>
        <field name="res_model">artec.gauging</field>
        <field name="view_mode">pivot,graph</field>
    </record>

</odoo>