<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="artec_gauging_view_tree" model="ir.ui.view">
        <field name="name">Artec Gauging Tree View</field>
        <field name="model">artec.gauging</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="tank_id"></field>
                <field name="date"></field>
                <field name="depth"></field>
                <field name="temperature"></field>
                <field name="theoretical_volume"></field>
                <field name="density"></field>
                <field name="coefficient"></field>
                <field name="volume"></field>
            </list>
        </field>
    </record>

    <record id="artec_gauging_view_form" model="ir.ui.view">
        <field name="name">Artec Gauging Form View</field>
        <field name="model">artec.gauging</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tank_id"></field>
                            <field name="date"></field>
                        </group>

                        <group>
                            <group>
                                <field name="depth"></field>
                                <field name="theoretical_volume"></field>
                            </group>
                            <group>
                                <field name="temperature"></field>
                                <field name="density"></field>
                                <field name="coefficient"></field>
                                <field name="volume"></field>
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="artec_gauging_view_search" model="ir.ui.view">
		<field name="name">Artec Gauging Search View</field>
		<field name="model">artec.gauging</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"></field>
				<field name="tank_id"></field>
				<field name="date"></field>
                <filter name="today" string="Today" domain="[('date', '=', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="yesterday" string="Yesterday" domain="[('date', '=', (datetime.datetime.now() + datetime.timedelta(days=-1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="last_week" string="Last Week" domain="[('date', '&gt;=', (datetime.datetime.now() + datetime.timedelta(days=-7)).strftime('%Y-%m-%d %H:%M:%S')), ('date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="last_month" string="Last Month" domain="[('date', '&gt;=', (datetime.datetime.now() + datetime.timedelta(days=-30)).strftime('%Y-%m-%d %H:%M:%S')), ('date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="last_three_months" string="Last 3 Months" domain="[('date', '&gt;=', (datetime.datetime.now() + datetime.timedelta(days=-90)).strftime('%Y-%m-%d %H:%M:%S')), ('date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="last_six_months" string="Last 6 Months" domain="[('date', '&gt;=', (datetime.datetime.now() + datetime.timedelta(days=-180)).strftime('%Y-%m-%d %H:%M:%S')), ('date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="last_year" string="Last Year" domain="[('date', '&gt;=', (datetime.datetime.now() + datetime.timedelta(days=-365)).strftime('%Y-%m-%d %H:%M:%S')), ('date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="group_by_tank" string="Tank" context="{'group_by': 'tank_id'}" />
                <filter name="group_by_daily" string="Date" context="{'group_by': 'date'}" />
			</search>
		</field>
	</record>

    <record id="artec_gauging_action" model="ir.actions.act_window">
		<field name="name">Gauging</field>
		<field name="res_model">artec.gauging</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>