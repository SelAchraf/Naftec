<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="artec_astm_view_tree" model="ir.ui.view">
        <field name="name">Artec ASTM Tree View</field>
        <field name="model">artec.astm</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="start_datetime"></field>
                <field name="end_datetime"></field>
                <field name="active"></field>
            </list>
        </field>
    </record>

    <record id="artec_astm_view_form" model="ir.ui.view">
        <field name="name">Artec ASTM Form View</field>
        <field name="model">artec.astm</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state == 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name" readonly="state == 'confirmed'"></field>
                        </h1>
                    </div>
                    <group>
                        <field name="start_datetime" readonly="state == 'confirmed'"></field>
                        <field name="end_datetime"></field>
                        <field name="active"></field>
                    </group>
                    <group>
                        <field name="astm_line_ids" readonly="state == 'confirmed'">
                            <list editable='bottom'>
                                <field name="temperature"></field>
                                <field name="density"></field>
                                <field name="coefficient"></field>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="artec_astm_view_search" model="ir.ui.view">
        <field name="name">Artec ASTM Search View</field>
        <field name="model">artec.astm</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"></field>
                <field name="start_datetime"></field>
                <field name="end_datetime"></field>
                <filter name="is_archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="active_yesterday" string="Yesterday" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(days = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_week" string="Last Week" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(weeks = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_month" string="Last Month" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(months = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_three_months" string="Last 3 Months" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(months = -3)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_six_months" string="Last 6 Months" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(months = -6)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <filter name="active_last_year" string="Last Year" domain="[
                    '&amp;',
                        ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d')),
                        '|',
                            ('end_datetime', '=', False),
                            ('end_datetime', '&gt;', (context_today() + relativedelta(years = -1)).strftime('%Y-%m-%d')),
                        ('active', 'in', [True, False])
                ]"/>
                <separator/>
                <filter name="started_yesterday" string="Started Yesterday" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(days = -1)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="started_last_week" string="Started Last Week" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(weeks = -1)).strftime('%Y-%m-%d')), ('start_datetime','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="started_last_month" string="Started Last Month" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(months = -1)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="started_last_three_months" string="Started Last 3 Months" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(months = -3)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="started_last_six_months" string="Started Last 6 Months" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(months = -6)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="started_last_year" string="Started Last Year" domain="[('start_datetime', '&gt;=', (context_today() + relativedelta(years = -1)).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="ended_yesterday" string="Ended Yesterday" domain="[('end_datetime', '&gt;=', (context_today() + relativedelta(days = -1)).strftime('%Y-%m-%d')), ('end_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ended_last_week" string="Ended Last Week" domain="[('end_datetime', '&gt;=', (context_today() + relativedelta(weeks = -1)).strftime('%Y-%m-%d')), ('end_datetime','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ended_last_month" string="Ended Last Month" domain="[('end_datetime', '&gt;=', (context_today() + relativedelta(months = -1)).strftime('%Y-%m-%d')), ('end_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ended_last_three_months" string="Ended Last 3 Months" domain="[('end_datetime', '&gt;=', (context_today() + relativedelta(months = -3)).strftime('%Y-%m-%d')), ('end_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ended_last_six_months" string="Ended Last 6 Months" domain="[('end_datetime', '&gt;=', (context_today() + relativedelta(months = -6)).strftime('%Y-%m-%d')), ('end_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ended_last_year" string="Ended Last Year" domain="[('end_datetime', '&gt;=', (context_today() + relativedelta(years = -1)).strftime('%Y-%m-%d')), ('end_datetime', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="Not Ended" string="Not Ended" domain="[('end_datetime', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="artec_astm_action" model="ir.actions.act_window">
        <field name="name">ASTM</field>
        <field name="res_model">artec.astm</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
