<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="artec_production_view_tree" model="ir.ui.view">
        <field name="name">Artec Production Tree View</field>
        <field name="model">artec.production</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="tank_id"></field>
                <field name="date"></field>
                <field name="volume"></field>
            </list>
        </field>
    </record>

    <record id="artec_production_view_form" model="ir.ui.view">
        <field name="name">Artec Production Form View</field>
        <field name="model">artec.production</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for='name'/>
                        <h1>
							<field name="name"></field>
                        </h1>
                    </div>
                    <group>
                        <field name="tank_id"/>
                        <field name="date"/>
                        <field name="volume"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="artec_production_action" model="ir.actions.act_window">
        <field name="name">Production</field>
        <field name="res_model">artec.production</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
